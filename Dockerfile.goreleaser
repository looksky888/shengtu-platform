# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

WORKDIR /app
ENV PORT=80
ENV CHATGPT2API_DEPLOYMENT=docker

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Same runtime identity as Dockerfile: the released image must not run as root,
# because the in-app updater renames files next to the running executable.
RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app

COPY --chown=appuser:appuser chatgpt2api /app/chatgpt2api

RUN chmod +x /app/chatgpt2api

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT:-80}/health || exit 1

USER 10001:10001

CMD ["/app/chatgpt2api"]

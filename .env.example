# ============================================
# shengtu / ChatGPT2API 环境变量示例
# ============================================
# 说明：
# 1. 复制本文件为 .env 后再按实际环境修改。
# 2. 生产环境必须修改管理员密码、数据库连接、站点地址等敏感配置。
# 3. 布尔值通常使用 true / false。

# ============================================
# 管理员与站点基础配置
# ============================================

# 管理员账号。首次部署建议保留 admin，登录后再按需调整。
CHATGPT2API_ADMIN_USERNAME=admin

# 管理员密码。生产环境必须设置强密码。
# CHATGPT2API_ADMIN_PASSWORD=change_me_please

# 是否开放普通用户注册。
CHATGPT2API_REGISTRATION_ENABLED=false

# 站点公开访问地址，用于 OAuth 回调、图片 URL、公告图片等外链拼接。
# CHATGPT2API_BASE_URL=https://your-domain.com

# 全局上游代理，支持 http/https/socks5/socks5h。
# CHATGPT2API_PROXY=http://127.0.0.1:7890

# 检查更新时使用的代理；留空时默认跟随 CHATGPT2API_PROXY。
# CHATGPT2API_UPDATE_PROXY_URL=http://127.0.0.1:7890

# 项目根目录，通常不需要设置；本地多版本调试时可指定到当前 source 目录。
# CHATGPT2API_ROOT=D:\\path\\to\\shengtu\\source

# 部署方式标记，例如 source、compose、docker，用于版本信息展示。
# CHATGPT2API_DEPLOYMENT=source

# Outlook 邮箱池 API 是否脱敏（清空 mailboxes 回显）。true/false。
# 未设置时：deployment=source/dev/local 默认不脱敏；其它环境默认脱敏。
# CHATGPT2API_OUTLOOK_REDACT=false

# GitHub Release 更新源和可选 Token。
# CHATGPT2API_UPDATE_REPO=looksky888/shengtu-platform
# Private repositories require a read-only GitHub token at runtime. Never commit it.
# CHATGPT2API_UPDATE_GITHUB_TOKEN=

# Optional P2A host updater connection. Generate one random value with at least
# 32 characters and keep the same value in /etc/shengtu-host-updater.env.
# SHENGTU_UPDATER_TOKEN=
# SHENGTU_UPDATER_SOCKET_DIR=/run/shengtu-updater

# ============================================
# 号池与生图基础配置
# ============================================

# 号池自动刷新间隔，单位：分钟。
CHATGPT2API_REFRESH_ACCOUNT_INTERVAL_MINUTE=5

# 全局生图并发限制。
CHATGPT2API_IMAGE_CONCURRENT_LIMIT=3
CHATGPT2API_IMAGE_WORKER_COUNT=8
CHATGPT2API_IMAGE_QUEUE_CAPACITY=256

# 图片任务超时时间，单位：秒。
CHATGPT2API_IMAGE_TASK_TIMEOUT_SECONDS=600

# 单账号上游生图流等待时间（秒）。超时后换其他账号重试；默认 90。
CHATGPT2API_IMAGE_ATTEMPT_TIMEOUT_SECONDS=80

# Cloudflare 挑战后账号冷却秒数（60–7200，默认 900=15 分钟）。
# CHATGPT2API_IMAGE_CHALLENGE_COOLDOWN_SECONDS=900

# --- WARP / FlareSolverr 上游 clearance（见 docker-compose.warp.yml）---
# CHATGPT2API_PROXY=http://privoxy:8118
# CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
# CHATGPT2API_UPSTREAM_CLEARANCE_ENABLED=true
# CHATGPT2API_UPSTREAM_CLEARANCE_MODE=flaresolverr
# CHATGPT2API_UPSTREAM_CLEARANCE_TIMEOUT_SEC=60
# CHATGPT2API_UPSTREAM_CLEARANCE_REFRESH_INTERVAL=3600

# 优雅退出等待秒数（15–600，默认 120），便于在途生图任务收尾。
# CHATGPT2API_SHUTDOWN_TIMEOUT_SECONDS=120

# --- 客户端 IP / 注册额度（见 docs/SHENGTU_3X_OPS.md「客户端 IP 与 TRUST_PROXY_HEADERS」）---
# 默认关闭：登录限流、注册额度、审计日志只用 TCP 对端 IP（RemoteAddr）。
# 公网直连时客户端可伪造 X-Forwarded-For，开启后伪造头可绕过 IP 额度。
# 仅在「可信反代已覆盖/剥离客户端转发头」时开启（nginx real_ip、Cloudflare 等）。
# CHATGPT2API_TRUST_PROXY_HEADERS=true
#
# 注册风控规则、临时邮箱域名和可信代理 CIDR 在后台“设置 → 注册邮件”中管理。
# 注册风控账本最大保留事件数（窗口外自动剪枝；默认 5000，范围 100–50000）。
# CHATGPT2API_REGISTER_QUOTA_MAX_EVENTS=5000
# 设备 Cookie HMAC 密钥（当前，用于签名+校验）。不设则首次启动写入 data/device_id.secret。
# CHATGPT2API_DEVICE_ID_SECRET=
# 轮换窗口：上一版密钥仅用于校验，签章仍用当前密钥。可逗号分隔多把。收口后删除本项。
# 软轮换：NEW→SECRET，OLD→PREVIOUS → 重启 → 流量迁移后去掉 PREVIOUS。
# 硬轮换（泄露）：只设新 SECRET、不设 PREVIOUS → 旧 Cookie 全失效，设备额度桶重置。
# CHATGPT2API_DEVICE_ID_SECRET_PREVIOUS=

# SMTP 密码加密主密钥。建议生产环境显式设置 32 字节随机值（可用 base64 或 hex）。
# 不设置时首次启动自动生成 data/email_settings.secret；备份恢复时必须同时恢复该文件。
# CHATGPT2API_EMAIL_SETTINGS_KEY=

# Grok Provider 账号凭据加密密钥：必须是 Base64 编码的 32 字节随机值。
# 与 INTERNAL_SERVICE_TOKEN 分开生成和保管；未配置时 Provider 只读总览可用，账号转换会明确失败。
# GROK_PROVIDER_CREDENTIAL_KEY=

# 隔离仓最大条数（默认 2000，范围 1–10000）。超限时优先淘汰最旧 temporary，保留 permanent。
# CHATGPT2API_QUARANTINE_MAX_ENTRIES=2000

# 单个号池账号的生图并发。
CHATGPT2API_IMAGE_ACCOUNT_CONCURRENCY=1

# 是否允许并行生成多张图片。
CHATGPT2API_IMAGE_PARALLEL_GENERATION=false

# 号池模式下轮询图片任务的最长等待时间，单位：秒。
CHATGPT2API_IMAGE_POLL_TIMEOUT_SECONDS=60

# 号池模式下轮询图片任务的间隔，单位：秒。
CHATGPT2API_IMAGE_POLL_INTERVAL_SECONDS=5

# 号池模式下提交任务后的首次等待时间，单位：秒。
CHATGPT2API_IMAGE_POLL_INITIAL_WAIT_SECONDS=5

# 每张图按分辨率扣除的积分。
CHATGPT2API_IMAGE_CREDIT_COST_1080P=1
CHATGPT2API_IMAGE_CREDIT_COST_2K=2
CHATGPT2API_IMAGE_CREDIT_COST_4K=3
CHATGPT2API_GROK_IMAGE_CREDIT_COST_1K=1
CHATGPT2API_GROK_IMAGE_CREDIT_COST_2K=2
# Grok 视频按实际选择时长计费：每秒积分 × 秒数。
CHATGPT2API_VIDEO_CREDIT_COST_PER_SECOND=1

# 用户默认并发限制，0 表示不额外限制。
CHATGPT2API_USER_DEFAULT_CONCURRENT_LIMIT=0

# 用户默认每分钟请求数限制，0 表示不额外限制。
CHATGPT2API_USER_DEFAULT_RPM_LIMIT=0

# 图片文件保留天数。超过天数的本地图片会被清理。
CHATGPT2API_IMAGE_RETENTION_DAYS=30

# 图片媒体存储：local 或 r2。R2 模式要求 STORAGE_BACKEND=sqlite/postgres/mysql。
CHATGPT2API_MEDIA_STORAGE_PROVIDER=local

# 是否按图片保留天数自动清理；R2 长期存储建议设为 false。
CHATGPT2API_MEDIA_AUTO_CLEANUP_ENABLED=true

# Cloudflare R2 私有桶配置。先在设置页测试连接并迁移旧图片，再切换 provider。
# CHATGPT2API_MEDIA_R2_ACCOUNT_ID=
# CHATGPT2API_MEDIA_R2_ACCESS_KEY_ID=
# CHATGPT2API_MEDIA_R2_SECRET_ACCESS_KEY=
# CHATGPT2API_MEDIA_R2_BUCKET=
# CHATGPT2API_MEDIA_R2_PREFIX=shengtu-media
# CHATGPT2API_MEDIA_R2_PRESIGN_TTL_SECONDS=300

# 日志保留天数。
CHATGPT2API_LOG_RETENTION_DAYS=7

# 自动移除异常账号。
CHATGPT2API_AUTO_REMOVE_INVALID_ACCOUNTS=true

# 自动移除被限流账号。
CHATGPT2API_AUTO_REMOVE_RATE_LIMITED_ACCOUNTS=false

# 日志级别，多个值用英文逗号分隔，例如：debug,info,warning,error。
# CHATGPT2API_LOG_LEVELS=warning,error

# ============================================
# 生图通道配置：号池模式 / 中转站 API 模式
# ============================================

# 生图通道：
# - account_pool：使用项目内号池生图。
# - proxy_api：使用 OpenAI 兼容中转站 API 生图。
# CHATGPT2API_IMAGE_PROVIDER=account_pool

# 中转站 API 地址，例如：https://api.example.com
# CHATGPT2API_IMAGE_PROXY_BASE_URL=https://api.example.com

# 中转站 API Key。生产环境不要提交到代码仓库。
# CHATGPT2API_IMAGE_PROXY_API_KEY=

# 当前使用的中转站生图模型。
# CHATGPT2API_IMAGE_PROXY_MODEL=gpt-image-2

# 已获取或允许选择的中转站模型列表，多个模型用英文逗号分隔。
# CHATGPT2API_IMAGE_PROXY_MODELS=gpt-image-2

# 中转站生图请求超时时间，单位：秒。
# CHATGPT2API_IMAGE_PROXY_TIMEOUT_SECONDS=300

# 中转站生图失败重试次数，建议 0-5。
# CHATGPT2API_IMAGE_PROXY_MAX_RETRIES=1

# 中转站返回 URL 图片时，是否自动下载并保存到本项目图片库。
CHATGPT2API_IMAGE_PROXY_DOWNLOAD_URLS=true

# ============================================
# 登录页图片配置
# ============================================

# 登录页展示图片地址，留空使用内置插画。
# CHATGPT2API_LOGIN_PAGE_IMAGE_URL=

# 登录页图片显示方式：cover、contain、fill。
# CHATGPT2API_LOGIN_PAGE_IMAGE_MODE=cover

# 登录页图片缩放比例。
# CHATGPT2API_LOGIN_PAGE_IMAGE_ZOOM=1

# 登录页图片位置百分比。
# CHATGPT2API_LOGIN_PAGE_IMAGE_POSITION_X=50
# CHATGPT2API_LOGIN_PAGE_IMAGE_POSITION_Y=50

# ============================================
# FlareSolverr / Cloudflare Clearance 注册处理
# ============================================

# 全局 FlareSolverr 地址。
# CHATGPT2API_FLARESOLVERR_URL=http://127.0.0.1:8191

# 注册任务遇到 Cloudflare challenge 时是否启用 clearance 处理。
# CHATGPT2API_REGISTER_CLEARANCE_ENABLED=false

# clearance 获取超时时间，单位：秒。
# CHATGPT2API_REGISTER_CLEARANCE_TIMEOUT_SECONDS=60

# clearance 刷新间隔，单位：秒。
# CHATGPT2API_REGISTER_CLEARANCE_REFRESH_INTERVAL_SECONDS=3600

# clearance 代理；留空跟随注册代理，direct 表示直连。
# CHATGPT2API_REGISTER_CLEARANCE_PROXY=

# 兼容旧变量名，优先使用上面的 REGISTER_CLEARANCE_*。
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_TIMEOUT_SEC=60
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_REFRESH_INTERVAL=3600

# ============================================
# 存储后端配置
# ============================================

# 存储后端：json、sqlite、postgres。
# 推荐生产环境使用 sqlite 或 postgres。
STORAGE_BACKEND=sqlite

# PostgreSQL 连接示例。
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase / PostgreSQL 连接示例。
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 连接示例。Docker 中通常为 /app/data/chatgpt2api.db。
# DATABASE_URL=sqlite:////app/data/chatgpt2api.db

# ============================================
# 3.7 侧车与功能开关（历史设计说明见 docs/v3.5/FEATURE_FLAGS.md）
# ============================================
# 生产目标组合示例（取消注释并填 token；代码默认仍保守）：
#   INTERNAL_SERVICE_TOKEN=...
#   CHATGPT2API_FEATURE_REGISTER_BACKEND=python
#   CHATGPT2API_FEATURE_GROK_REGISTER=true
#   CHATGPT2API_FEATURE_ICLOUD=true
#   ICLOUD_PRIVACY_MAIL_BASE_URL=http://icloud-privacy-mail:8787
#   GROK_RUNTIME_BASE_URL=http://grok-runtime:8091
#   SHENGTU_BASE_URL=http://app:8092
#   SHENGTU_POOL_SYNC_ENABLED=true
#   CHATGPT2API_UPSTREAM_CLEARANCE_ENABLED=true
#   CHATGPT2API_UPSTREAM_CLEARANCE_MODE=flaresolverr
#   CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191

# 主站 → 侧车共享密钥（生产必填强随机串）
# 生成示例：openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# 默认只绑定本机；公网部署请使用 TLS 反向代理。
CHATGPT2API_BIND_ADDR=127.0.0.1
CHATGPT2API_PORT=3004

# 主站内部 API 独立监听地址；v3.7 Compose 已固定为 :8092。
# CHATGPT2API_INTERNAL_LISTEN_ADDR=:8092

# iCloud Privacy Mail sidecar
# CHATGPT2API_FEATURE_ICLOUD=false
# ICLOUD_PRIVACY_MAIL_BASE_URL=http://icloud-privacy-mail:8787

# Grok 生图：固定走 grok-runtime 号池（已移除 grok_proxy 外部中转）
# GROK_RUNTIME_BASE_URL=http://grok-runtime:8091

# 注册后端：go（过渡）| python（3.7 目标：OpenAI+Grok 均在侧车）
# CHATGPT2API_FEATURE_REGISTER_BACKEND=go
# CHATGPT2API_FEATURE_GROK_REGISTER=false

# Python 注册成功后回写主站号池（侧车 → app）
# SHENGTU_BASE_URL=http://app:8092
# SHENGTU_POOL_SYNC_ENABLED=true
# SHENGTU_POOL_SYNC_REFRESH=true
# Grok 号池批量额度/检测的有界 Worker 数（按上游限流能力调整，默认 3）
# GROK_PROVIDER_QUOTA_WORKERS=3
# GROK_PROVIDER_DETECTION_WORKERS=3


# Copy to .env for local WARP stack:
#   cp .env.with-warp.example .env
# Then:
#   docker compose -f docker-compose.warp.yml up -d --build

PORT=80
CHATGPT2API_BIND_ADDR=127.0.0.1
CHATGPT2API_PORT=3004
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:////app/data/chatgpt2api.db

# --- WARP egress (app -> privoxy -> warp) ---
CHATGPT2API_PROXY=http://privoxy:8118

# --- FlareSolverr clearance for chatgpt.com (image/bootstrap) ---
CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
CHATGPT2API_UPSTREAM_CLEARANCE_ENABLED=true
CHATGPT2API_UPSTREAM_CLEARANCE_MODE=flaresolverr
CHATGPT2API_UPSTREAM_CLEARANCE_TIMEOUT_SEC=60
CHATGPT2API_UPSTREAM_CLEARANCE_REFRESH_INTERVAL=3600

# CF account cool-down after challenge (seconds); default was hard-coded 3600
CHATGPT2API_IMAGE_CHALLENGE_COOLDOWN_SECONDS=900

# Image attempt timeout then switch account
CHATGPT2API_IMAGE_ATTEMPT_TIMEOUT_SECONDS=80
CHATGPT2API_IMAGE_TASK_TIMEOUT_SECONDS=300
CHATGPT2API_IMAGE_CONCURRENT_LIMIT=20
CHATGPT2API_IMAGE_ACCOUNT_CONCURRENCY=2
CHATGPT2API_IMAGE_ACCOUNT_SCHEDULE=least_loaded
CHATGPT2API_IMAGE_PROVIDER=account_pool
CHATGPT2API_IMAGE_DEFAULT_MODEL=gpt-image-2
CHATGPT2API_IMAGE_INTERNAL_MODEL_SLUG=gpt-5-5-thinking
CHATGPT2API_IMAGE_FALLBACK_MODEL_ENABLED=true
CHATGPT2API_IMAGE_FALLBACK_MODEL_SLUGS=gpt-5-5-thinking,gpt-5-3,gpt-5.5

# Register clearance can reuse same FlareSolverr
CHATGPT2API_REGISTER_CLEARANCE_ENABLED=true
CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191

# Optional WARP+
# WARP_LICENSE_KEY=
WARP_SOCKS_PORT=40000
PRIVOXY_PORT=40080
FLARESOLVERR_PORT=8191
TZ=Asia/Shanghai
# 4.6 必填：主服务/solver 共用密钥，solver 与主服务使用同一 CHATGPT2API_PROXY。
# CHATGPT2API_SENTINEL_SOLVER_KEY=<至少32字符的随机密钥>
# SENTINEL_SOLVER_TIMEZONE=<核对 WARP 实际出口后填写 IANA 时区>
